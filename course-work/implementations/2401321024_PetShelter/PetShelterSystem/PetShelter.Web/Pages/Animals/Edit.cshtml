@page "{id:int}"
@model PetShelter.Web.Pages.Animals.EditModel
@{
    ViewData["Title"] = "Редактирай животно";
    ViewData["ActivePage"] = "Animals";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="mb-4">
                    <i class="bi bi-pencil-square text-warning"></i> Редактирай животно
                </h4>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Име</label>
                        <input type="text" class="form-control" asp-for="Input.Name" maxlength="15" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Вид <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="Input.Species" maxlength="20" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Дата на раждане</label>
                        <input type="date" class="form-control" asp-for="Input.BirthDate" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Тегло (кг) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" class="form-control" asp-for="Input.Weight" required />
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" asp-for="Input.IsVaccinated" />
                        <label class="form-check-label">Ваксиниран</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Дата на пристигане <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" asp-for="Input.ArrivalDate" required />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> Запази
                        </button>
                        <a href="/Animals" class="btn btn-secondary">Отказ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>