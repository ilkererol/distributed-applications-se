@page "{id:int}"
@model PetShelter.Web.Pages.Animals.DeleteModel
@{
    ViewData["Title"] = "Изтрий животно";
    ViewData["ActivePage"] = "Animals";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-danger">
            <div class="card-body p-4 text-center">
                <h4 class="text-danger mb-3">
                    <i class="bi bi-exclamation-triangle-fill"></i> Изтриване
                </h4>
                <p class="mb-1">Сигурен ли си, че искаш да изтриеш:</p>
                <h5 class="mb-4">@(Model.AnimalName ?? "това животно")</h5>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-center gap-3">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Да, изтрий
                        </button>
                        <a href="/Animals" class="btn btn-secondary">Отказ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>