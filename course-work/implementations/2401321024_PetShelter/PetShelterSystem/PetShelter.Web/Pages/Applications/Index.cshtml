@page
@model PetShelter.Web.Pages.Applications.IndexModel
@{
    ViewData["Title"] = "Заявления";
    ViewData["ActivePage"] = "Applications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-file-earmark-text-fill text-primary"></i> Заявления за осиновяване</h3>
    <a href="/Applications/Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Добави заявление
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Вид животно</label>
                <input type="text" class="form-control" name="species"
                       value="@Model.Species" placeholder="напр. Куче" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Дата на заявление</label>
                <input type="date" class="form-control" name="applicationDate"
                       value="@Model.ApplicationDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Сортирай по</label>
                <select class="form-select" name="sortBy">
                    <option value="">--</option>
                    <option value="ApplicationDate" selected="@(Model.SortBy == "ApplicationDate")">Дата</option>
                    <option value="ProcessingFee" selected="@(Model.SortBy == "ProcessingFee")">Такса</option>
                    <option value="Species" selected="@(Model.SortBy == "Species")">Вид</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Посока</label>
                <select class="form-select" name="ascending">
                    <option value="true" selected="@(Model.Ascending)">Възходящо</option>
                    <option value="false" selected="@(!Model.Ascending)">Низходящо</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-search"></i> Търси
                </button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Applications.Any())
{
    <div class="alert alert-info">Няма намерени заявления.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Осиновител</th>
                    <th>Вид животно</th>
                    <th>Дата на заявление</th>
                    <th>Такса (лв.)</th>
                    <th>Бележки</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Model.Applications)
                {
                    <tr>
                        <td>@app.AdopterName</td>
                        <td>@app.Species</td>
                        <td>@app.ApplicationDate.ToString("dd.MM.yyyy")</td>
                        <td>@app.ProcessingFee.ToString("F2")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(app.Notes))
                            {
                                <span data-bs-toggle="tooltip" title="@app.Notes">
                                    <i class="bi bi-chat-left-text text-secondary"></i>
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <a href="/Applications/Edit/@app.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a href="/Applications/Delete/@app.Id" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav>
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link"
                       href="?page=@i&species=@Model.Species&applicationDate=@Model.ApplicationDate?.ToString("yyyy-MM-dd")&sortBy=@Model.SortBy&ascending=@Model.Ascending">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <script>
        const tooltipEls = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltipEls.forEach(el => new bootstrap.Tooltip(el));
    </script>
}