@page
@model PetShelter.Web.Pages.Adopters.CreateModel
@{
    ViewData["Title"] = "Добави осиновител";
    ViewData["ActivePage"] = "Adopters";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="mb-4">
                    <i class="bi bi-person-plus-fill text-primary"></i> Добави осиновител
                </h4>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Име <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="Input.FirstName"
                               maxlength="20" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Фамилия <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="Input.LastName"
                               maxlength="20" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Телефон <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="Input.Phone"
                               maxlength="15" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Дата на регистрация <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" asp-for="Input.RegistrationDate" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Финансов принос (лв.) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" class="form-control"
                               asp-for="Input.BudgetContribution" required />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Запази
                        </button>
                        <a href="/Adopters" class="btn btn-secondary">Отказ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>