@page
@model PetShelter.Web.Pages.Adopters.IndexModel
@{
    ViewData["Title"] = "Осиновители";
    ViewData["ActivePage"] = "Adopters";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-people-fill text-primary"></i> Осиновители</h3>
    <a href="/Adopters/Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Добави осиновител
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Фамилия</label>
                <input type="text" class="form-control" name="lastName"
                       value="@Model.LastName" placeholder="напр. Иванов" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Телефон</label>
                <input type="text" class="form-control" name="phone"
                       value="@Model.Phone" placeholder="напр. 0888..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Сортирай по</label>
                <select class="form-select" name="sortBy">
                    <option value="">--</option>
                    <option value="FirstName" selected="@(Model.SortBy == "FirstName")">Име</option>
                    <option value="LastName" selected="@(Model.SortBy == "LastName")">Фамилия</option>
                    <option value="RegistrationDate" selected="@(Model.SortBy == "RegistrationDate")">Дата</option>
                    <option value="BudgetContribution" selected="@(Model.SortBy == "BudgetContribution")">Принос</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Посока</label>
                <select class="form-select" name="ascending">
                    <option value="true" selected="@(Model.Ascending)">Възходящо</option>
                    <option value="false" selected="@(!Model.Ascending)">Низходящо</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-search"></i> Търси
                </button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Adopters.Any())
{
    <div class="alert alert-info">Няма намерени осиновители.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Име</th>
                    <th>Фамилия</th>
                    <th>Телефон</th>
                    <th>Дата на регистрация</th>
                    <th>Финансов принос</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var adopter in Model.Adopters)
                {
                    <tr>
                        <td>@adopter.FirstName</td>
                        <td>@adopter.LastName</td>
                        <td>@adopter.Phone</td>
                        <td>@adopter.RegistrationDate.ToString("dd.MM.yyyy")</td>
                        <td>@adopter.BudgetContribution.ToString("F2") лв.</td>
                        <td>
                            <a href="/Adopters/Edit/@adopter.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a href="/Adopters/Delete/@adopter.Id" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav>
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link"
                       href="?page=@i&lastName=@Model.LastName&phone=@Model.Phone&sortBy=@Model.SortBy&ascending=@Model.Ascending">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
}