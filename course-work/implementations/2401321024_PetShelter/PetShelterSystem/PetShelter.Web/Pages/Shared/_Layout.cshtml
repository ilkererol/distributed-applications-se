<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Pet Shelter</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.4rem;
        }

        .sidebar {
            min-height: calc(100vh - 56px);
            background-color: #212529;
            padding-top: 1rem;
        }

            .sidebar .nav-link {
                color: #adb5bd;
                font-size: 0.95rem;
                padding: 0.6rem 1.2rem;
                border-radius: 6px;
                margin-bottom: 2px;
            }

                .sidebar .nav-link:hover,
                .sidebar .nav-link.active {
                    background-color: #0d6efd;
                    color: #fff;
                }

                .sidebar .nav-link i {
                    margin-right: 8px;
                }

        .main-content {
            padding: 2rem;
        }

        .sidebar-heading {
            color: #6c757d;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 0.5rem 1.2rem;
            margin-top: 1rem;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-dark bg-dark px-3">
        <a class="navbar-brand" href="/">
            <i class="bi bi-house-heart-fill text-primary"></i> PetShelter
        </a>
        <div class="d-flex align-items-center gap-3">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="text-light">
                    <i class="bi bi-person-circle"></i> @User.Identity.Name
                </span>
                <form method="post" action="/Auth/Logout" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-box-arrow-right"></i> Изход
                    </button>
                </form>
            }
            else
            {
                <a href="/Auth/Login" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-box-arrow-in-right"></i> Вход
                </a>
            }
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="col-auto col-md-2 sidebar d-flex flex-column">
                    <p class="sidebar-heading">Меню</p>
                    <nav class="nav flex-column">
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Animals" ? "active" : "")"
                           href="/Animals">
                            <i class="bi bi-piggy-bank"></i> Животни
                        </a>
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Adopters" ? "active" : "")"
                           href="/Adopters">
                            <i class="bi bi-people-fill"></i> Осиновители
                        </a>
                        <a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Applications" ? "active" : "")"
                           href="/Applications">
                            <i class="bi bi-file-earmark-text-fill"></i> Заявления
                        </a>
                    </nav>
                </div>
            }

            <div class="col main-content">
                @RenderBody()
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>