@page
@model PetShelter.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Вход";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="card-title text-center mb-4">
                    <i class="bi bi-box-arrow-in-right text-primary"></i> Вход
                </h4>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Потребителско име</label>
                        <input type="text" class="form-control" asp-for="Input.Username" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Парола</label>
                        <input type="password" class="form-control" asp-for="Input.Password" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-box-arrow-in-right"></i> Влез
                    </button>
                </form>

                <hr />
                <p class="text-center mb-0">
                    Нямаш акаунт?
                    <a href="/Auth/Register">Регистрирай се</a>
                </p>
            </div>
        </div>
    </div>
</div>